>>> (wrap.break_before.binary_operator=true) The preset moves a binary right side to its own line; operands share its column.
final total = subtotal + shipping + tax - discount;
<<<
final total =
    subtotal
    + shipping
    + tax
    - discount;
>>> (wrap.break_before.binary_operator=true wrap.binary_expressions.break_after_prefix=false) The first operand stays on the prefix line.
final total = subtotal + shipping + tax - discount;
<<<
final total = subtotal
    + shipping
    + tax
    - discount;
>>> (wrap.break_before.binary_operator=true wrap.binary_expressions.break_after_prefix=false) After a named argument, offset from the argument's line.
g(total: subtotal + shipping + tax);
<<<
g(
  total: subtotal
      + shipping
      + tax,
);
>>> (wrap.break_before.binary_operator=true wrap.binary_expressions.break_after_prefix=false) After `=>`.
int h() => subtotal + shippingCost + taxAmount;
<<<
