>>> (spaces.around_binary_operators=false) Operator characters never touch: `?? `.
x = y as T? ?? z;
<<<
x = y as T? ??z;
>>> (spaces.around_binary_operators=false) Operator characters never touch: `! ==`.
x = y! == z;
<<<
x = y! ==z;
>>> (wrap.arguments=never) A line comment forces a break even under never.
f(a, // about a
    b);
<<<
f(
  a, // about a
  b,
);
>>> (wrap.arguments=fill wrap.keep_existing_line_breaks=false trailing_commas=preserve wrap.chop_on_trailing_comma=false) An own-line comment keeps its item on a new line in a filled list.
f(
  // about a
  a,
  // about b
  b,
);
<<<
f(
  // about a
  a,
  // about b
  b,
);
>>> (wrap.arguments.indent=first_item wrap.arguments.break_after_open_bracket=false wrap.arguments.break_before_close_bracket=false) Aligned list: a comment on the last item keeps the bracket off its line.
f(a,
  b // about b
);
<<<
f(a,
  b, // about b
);
>>> (wrap.arguments.indent=first_item wrap.arguments.break_after_open_bracket=false wrap.arguments.break_before_close_bracket=false) With both bracket fields false, a source comma is dropped and is not a chop request.
x = f(
  <int>{},
)!;
<<<
x = f(<int>{})!;
>>> (wrap.binary_expressions=never) A line comment forces a binary expression to break.
x = a + // about a
    b;
<<<
x =
    a +
    // about a
    b;
>>> (wrap.binary_expressions=fill) A switch operand in a filled binary is measured broken, so its arms lay out stably.
x = a && switch (d) { Aspect.systemGestureInsets => data.systemGestureInsets != old.data.systemGestureInsets };
<<<
x =
    a &&
    switch (d) {
      Aspect.systemGestureInsets =>
        data.systemGestureInsets != old.data.systemGestureInsets
    };
